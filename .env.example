# n8n Webhook URL for synchronization
# Example: https://your-n8n-instance.com/webhook/soussou-souvenirs
VITE_N8N_WEBHOOK_URL=

# Secret key for authentication (optional)
# If not set, the app will be in "open access" mode
# Example: FAMILLE2024SECRET
VITE_APP_SECRET_KEY=

# Maximum file size in bytes (default: 50MB)
# 50MB = 52428800 bytes
VITE_MAX_FILE_SIZE=52428800

# Environment
# development | production
NODE_ENV=production
